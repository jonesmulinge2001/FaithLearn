generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(uuid())
  email                  String                  @unique
  password               String
  name                   String
  role                   UserRole                @default(LEARNER)
  phone                  String?                 @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  isVerified             Boolean                 @default(false)
  resetToken             String?
  resetTokenExpiresAt    DateTime?
  verifyToken            String
  verifyTokenExpiresAt   DateTime?
  lastLogin              DateTime?
  isDeleted              Boolean                 @default(false)
  deletedAt              DateTime?
  profile                Profile?
  StudentCourse          StudentCourse[]
  StudentLesson          StudentLesson[]
  lessonAnswers          StudentLessonAnswer[]
  studentLessonQuestions StudentLessonQuestion[]
}

model Profile {
  id           String  @id @default(uuid())
  name         String
  bio          String?
  profileImage String?
  coverPhoto   String?
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id])
}

model Lesson {
  id               String                  @id @default(uuid())
  title            String
  content          String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  isDeleted        Boolean                 @default(false)
  courseId         String
  Course           Course                  @relation(fields: [courseId], references: [id])
  questions        LessonQuestion[]
  StudentLesson    StudentLesson[]
  studentQuestions StudentLessonQuestion[]
}

model LessonQuestion {
  id       String                @id @default(uuid())
  lessonId String
  question String
  answer   String?
  lesson   Lesson                @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  answers  StudentLessonAnswer[]
}

model StudentLessonQuestion {
  id        String   @id @default(uuid())
  lessonId  String
  studentId String
  question  String
  answer    String?
  createdAt DateTime @default(now())
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [id])
}

model StudentLessonAnswer {
  id         String         @id @default(uuid())
  studentId  String
  questionId String
  answer     String
  createdAt  DateTime       @default(now())
  question   LessonQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  student    User           @relation(fields: [studentId], references: [id])
}

model Course {
  id            String          @id @default(uuid())
  title         String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt    
  isDeleted     Boolean         @default(false)
  Lesson        Lesson[]
  StudentCourse StudentCourse[]
}

model StudentCourse {
  id         String   @id @default(uuid())
  studentId  String
  courseId   String
  enrolledAt DateTime @default(now())
  Course     Course   @relation(fields: [courseId], references: [id])
  User       User     @relation(fields: [studentId], references: [id])

  @@unique([studentId, courseId])
}

model StudentLesson {
  id        String   @id
  studentId String
  lessonId  String
  startedAt DateTime @default(now())
  Lesson    Lesson   @relation(fields: [lessonId], references: [id])
  User      User     @relation(fields: [studentId], references: [id])

  @@unique([studentId, lessonId])
}

enum UserRole {
  ADMIN
  LEARNER
}
